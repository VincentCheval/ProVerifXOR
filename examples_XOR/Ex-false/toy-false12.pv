
free c: channel.

(* set verboseRules = true. *)
(* set verboseBase=true. *)

fun senc(bitstring,bitstring): bitstring.
reduc forall x:bitstring, y:bitstring; sdec(senc(x,y),y) = x.

free k:bitstring [private].
free a1: bitstring [private].
free b1: bitstring [private].
free a2: bitstring [private].
free b2: bitstring [private].

query attacker(xor(a2,b2)).

process
  (in(c,z:bitstring); let (x1:bitstring,x2:bitstring) = sdec(z,k) in out(c, xor(x1,x2))) | out(c,a1) | out(c,b1) | out(c,senc((xor(a1,a2),xor(b1,b2)),k)).

