free c: channel.

free s:bitstring [private].
free n1:bitstring [private].
free n2:bitstring [private].
free n3:bitstring [private].
free n4:bitstring [private].

query attacker(s).

process
	out(c,xor(n1,xor(n2,n3))); out(c,xor(xor(n1,n3),n4)); out(c,n2);  in(c,=n4);  out(c,s)
