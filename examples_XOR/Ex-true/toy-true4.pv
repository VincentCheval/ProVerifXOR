free c: channel.

type host.
type key.
type pkey.
type skey.
type spkey.
type sskey.

set verboseRules = true.
set simpEqAll = true.
set verboseBase=true.

fun hash(bitstring): bitstring.

free k:bitstring [private].
free s:bitstring [private].

query attacker(s).

process
