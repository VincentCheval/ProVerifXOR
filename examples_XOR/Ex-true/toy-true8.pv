
free c: channel.

type host.
type key.
type pkey.
type skey.
type spkey.
type sskey.

set verboseRules = true.
set verboseBase=true. 

fun hash(bitstring): bitstring.

free s:bitstring [private].

query attacker(s).

process
  !in(c,x:bitstring);  new k[]:bitstring; out(c, xor(x,k))


