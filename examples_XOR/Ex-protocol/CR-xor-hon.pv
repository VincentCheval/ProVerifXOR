(* CR-xor - Toy exemple provided in
   Jannik Dreier, Lucca Hirschi, Sasa Radomirovic, Ralf Sasse:
   Automated Unbounded Verification of Stateful Cryptographic Protocols with Exclusive OR. CSF 2018: 359-373

   I -> R: na
   R -> I: <h(na+nb+k), nb>

   Our model:
    - we consider a model with many tags/readers, and an arbitrary number of sessions of each

   Security properties:
    - aliveness: when the reader receives the last message, he know that the tag id has played before
    - recent aliveness: when the reader receives the last message, he know that the tag id has played recently (presence of r1)
    - secrecy of the key k shared between the tag and the reader

  Whereas secrecy and  aliveness hold, recent aliveness does not hold as an attacker can craft a correct response after having observed one real response.

  Comparison with the model provided in CSF'08
  In the original model provided in CSF'08, only one tag and one reader that can play many sessions each are considered.
  Here, we consider many tags/readers.

*)


free c: channel.

fun h(bitstring): bitstring.
fun rot(bitstring,bitstring): bitstring.
fun lh(bitstring): bitstring.
fun rh(bitstring): bitstring.

(* k, na, nb *)
event endR(bitstring,bitstring,bitstring).
event startT(bitstring,bitstring,bitstring).

(* alivenes - true *)
query x1: bitstring, x2: bitstring, x3:bitstring, y2:bitstring, y3: bitstring;
          event(endR(x1,x2,x3)) ==> event(startT(x1,y2,y3)).

(* recent aliveness - false *)
query x1: bitstring, x2: bitstring, x3: bitstring, x4:bitstring;
          event(endR(x1,x2,x3)) ==> event(startT(x1,x2,x4)).

(* secrecy - true *)
query attacker(new k).


let reader(k:bitstring) = 
    new na:bitstring; 
    out(c,na); 
    in(c,(x1:bitstring,x2:bitstring)); 
    if x1 = h(xor(na,xor(x2,k))) then event endR(k,na,x2).


let tag(k:bitstring) = 
    in(c,y:bitstring); 
    new nb:bitstring; 
    event startT(k,y,nb);
    let hashT = h(xor(y,xor(nb,k))) in 
    out(c,(hashT,nb)).

process
   ! new k:bitstring; (!reader(k) | !tag(k))
 


